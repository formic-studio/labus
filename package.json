{
  "name": "labus",
  "version": "1.0.0",
  "private": true,
  "description": "Dedykowany motyw potomny Bricks dla projektu Labus.",
  "type": "module",
  "author": "Formic Studio (https://kamil-kolodziejczyk.formic.studio/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formic-studio/labus.git"
  },
  "engines": {
    "node": "^26.13.1",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "dev": "vite build --mode development --watch --clearScreen false",
    "build": "vite build --mode production",
    "typecheck": "tsc --noEmit",
